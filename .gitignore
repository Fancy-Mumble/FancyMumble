# ---- Rust / Cargo ----
/target/
**/target/
**/*.rs.bk

# Keep Cargo.lock for app crates (do not ignore by default)

# ---- Environment / local config ----
.env
.env.*
!.env.example
!.env.sample

# ---- Node / frontend (crates/mumble-tauri/ui) ----
# Any node_modules, including the stray vitest cache a root-level test run leaves.
node_modules/
crates/mumble-tauri/ui/node_modules/
crates/mumble-tauri/ui/dist/
crates/mumble-tauri/ui/.vite/
crates/mumble-tauri/ui/coverage/
crates/mumble-tauri/ui/.eslintcache
crates/mumble-tauri/ui/*.tsbuildinfo
crates/mumble-tauri/ui/npm-debug.log*
crates/mumble-tauri/ui/yarn-debug.log*
crates/mumble-tauri/ui/yarn-error.log*
crates/mumble-tauri/ui/pnpm-debug.log*

# ---- Tauri / desktop runtime artifacts ----
**/*.pdb
**/*.dSYM/
**/*.ilk
**/*.exe

# ---- Signal bridge (AGPL dynamic library) ----
# Built binaries go here for Tauri bundling; only .gitkeep is tracked.
crates/mumble-tauri/signal-bridge/*.dll
crates/mumble-tauri/signal-bridge/*.so
crates/mumble-tauri/signal-bridge/*.dylib

# ---- Dioxus ----
crates/mumble-gui/.dioxus/
crates/mumble-gui/dist/

# ---- IDE / editor ----
.vscode/
.idea/
*.code-workspace
.claude/

# ---- OS noise ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Test / misc local artifacts ----
coverage/
*.log

google-services.json
.env.local
# dhat heap profiler output (cargo run --features dhat-heap)
dhat-heap*.json

# pnpm's content-addressable store, wherever it is run from. The UI builds with
# npm, but `pnpm-debug.log*` above shows pnpm does get invoked here sometimes,
# and the store it leaves behind is a large untracked tree nobody wants staged.
.pnpm-store/

# flatpak-builder scratch (packaging/flatpak/README.md)
.flatpak-builder/

# vitest cache, written next to the crate rather than under ui/
crates/mumble-tauri/node_modules/
# built preview bundles; the entries beside them are the source
crates/mumble-tauri/ui/preview/dist-*/
