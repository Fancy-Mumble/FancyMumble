# ---- Rust / Cargo ----
/target/
**/target/
**/*.rs.bk

# Keep Cargo.lock for app crates (do not ignore by default)

# ---- Environment / local config ----
.env
.env.*
!.env.example
!.env.sample

# ---- Node / frontend (src/ui/tauri/ui) ----
# Any node_modules, including the stray vitest cache a root-level test run leaves.
node_modules/
src/ui/tauri/ui/node_modules/
src/ui/tauri/ui/dist/
src/ui/tauri/ui/.vite/
src/ui/tauri/ui/coverage/
src/ui/tauri/ui/.eslintcache
src/ui/tauri/ui/*.tsbuildinfo
src/ui/tauri/ui/npm-debug.log*
src/ui/tauri/ui/yarn-debug.log*
src/ui/tauri/ui/yarn-error.log*
src/ui/tauri/ui/pnpm-debug.log*

# ---- Tauri / desktop runtime artifacts ----
**/*.pdb
**/*.dSYM/
**/*.ilk
**/*.exe

# ---- Signal bridge (AGPL dynamic library) ----
# Built binaries go here for Tauri bundling; only .gitkeep is tracked.
src/ui/tauri/signal-bridge/*.dll
src/ui/tauri/signal-bridge/*.so
src/ui/tauri/signal-bridge/*.dylib

# ---- IDE / editor ----
.vscode/
.idea/
*.code-workspace
.claude/

# ---- OS noise ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Test / misc local artifacts ----
coverage/
*.log

google-services.json
.env.local
# dhat heap profiler output (cargo run --features dhat-heap)
dhat-heap*.json

# pnpm's content-addressable store, wherever it is run from. The UI builds with
# npm, but `pnpm-debug.log*` above shows pnpm does get invoked here sometimes,
# and the store it leaves behind is a large untracked tree nobody wants staged.
.pnpm-store/

# flatpak-builder scratch (packaging/flatpak/README.md)
.flatpak-builder/

# vitest cache, written next to the crate rather than under ui/
src/ui/tauri/node_modules/
# built preview bundles; the entries beside them are the source
src/ui/tauri/ui/preview/dist-*/

# ---- Tauri ----
# Rewritten by tauri-build on every compile; an editor aid, nothing reads it.
src/ui/tauri/gen/schemas/

# ---- Benchmarks ----
# Appended to by scripts/bench-app.ps1 -Save.
scripts/bench-history.csv
