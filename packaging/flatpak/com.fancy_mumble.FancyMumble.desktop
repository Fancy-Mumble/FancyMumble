[Desktop Entry]
Type=Application
Name=Fancy Mumble
GenericName=Voice Chat
Comment=Talk, chat and share your screen on a Mumble server
Exec=mumble-tauri %u
Icon=com.fancy_mumble.FancyMumble
Terminal=false
# One main category only: adding AudioVideo as well makes the entry show up
# twice in menus that group by main category.
Categories=Network;InstantMessaging;
Keywords=mumble;voice;voip;chat;
# Tauri names the GTK window after the binary, not after the Flatpak ID, so
# this is what lets the shell match a running window back to this entry.
StartupWMClass=mumble-tauri
# The scheme src/app/mod.rs registers at runtime; declared here so the
# installed entry carries it rather than the copy the app writes into
# ~/.local/share, which the sandbox would keep to itself anyway.
MimeType=x-scheme-handler/fancy;
